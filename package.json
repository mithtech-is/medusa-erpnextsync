{
  "name": "medusa-plugin-erpnext",
  "version": "0.1.0",
  "description": "ERPNext (Frappe) bidirectional sync as a Medusa v2 plugin. Push customers / orders / products / custom events via the live event bus + admin replay; pull a read-only Frappe REST proxy for previewing remote doctypes. Mapping engine with configurable doctype field mappings, triggers, and an admin console. Frappe endpoint is configurable per deployment.",
  "license": "UNLICENSED",
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "erpnext",
    "frappe",
    "sync"
  ],
  "files": [
    ".medusa/server",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit",
    "prepare": "medusa plugin:build || true"
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/test-utils": "^2.19.0",
    "@medusajs/ui": "^4.0.4",
    "@swc/core": "^1.5.7",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/ui": "^4.0.4",
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": ">=5"
  }
}
