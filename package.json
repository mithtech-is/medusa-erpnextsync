{
  "name": "@mithtech-medusa/plugin-erpnext",
  "version": "0.1.2",
  "description": "ERPNext (Frappe) sync as a Medusa v2 plugin. ERPNext → Medusa catalogue over Frappe core Webhooks and a scheduled pull, selected per document with a medusa_sync field the plugin creates; mapping engine with configurable doctype field mappings and an admin console. Nothing is installed on ERPNext.",
  "license": "UNLICENSED",
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "erpnext",
    "frappe",
    "sync"
  ],
  "files": [
    ".medusa/server",
    "package.json",
    "README.md",
    "factory.extension.yaml"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepare": "medusa plugin:build || true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "@aws-sdk/client-s3": "3.1116.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.21.0",
    "@medusajs/cli": "^2.21.0",
    "@medusajs/framework": "^2.21.0",
    "@medusajs/icons": "^2.21.0",
    "@medusajs/medusa": "^2.21.0",
    "@medusajs/test-utils": "^2.21.0",
    "@medusajs/ui": "^4.0.4",
    "@swc/core": "^1.5.7",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/ui": "^4.0.4",
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": ">=5"
  },
  "publishConfig": {
    "registry": "https://npm.po5.in/"
  }
}
